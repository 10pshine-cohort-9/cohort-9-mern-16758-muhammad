{
  "name": "@shine-notes/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Shine Notes application.",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:test:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "db:test:status": "prisma migrate status --config prisma.test.config.ts",
    "db:validate": "prisma validate",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "mocha --node-option=import=tsx --reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "c8 --all --include=src/**/*.ts --exclude=src/server.ts --exclude=src/generated/** --reporter=text --reporter=lcov --check-coverage --lines=80 --statements=80 --functions=80 --branches=75 npm test",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.0",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "mocha": "^11.7.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1"
  }
}
