{
  "name": "@shine-notes/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Shine Notes application.",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "mocha --node-option=import=tsx --reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "c8 --all --include=src/**/*.ts --exclude=src/server.ts --reporter=text --reporter=lcov --check-coverage --lines=80 --statements=80 --functions=80 --branches=75 npm test",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.0",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1"
  }
}
